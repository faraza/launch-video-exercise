{
  "name": "launch-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn a website URL into a ~20s launch video",
  "scripts": {
    "postinstall": "playwright install chromium",
    "check": "python3 scripts/check_output.py",
    "web": "node web/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dotenv": "^18.0.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "ffprobe-static@3.1.0": true
  }
}
