#!/usr/bin/env bash
# Usage: ./make-video <url> <out_dir>
# Writes <out_dir>/video.mp4, <out_dir>/poster.png, <out_dir>/caption.txt.
# Thin wrapper: all logic lives in src/ (Node). Works on macOS, Linux, Git Bash.
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: ./make-video <url> <out_dir>" >&2
  exit 2
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "node not found; install Node 20+ (https://nodejs.org)" >&2
  exit 1
fi
if [ ! -d "$HERE/node_modules" ]; then
  echo "dependencies missing; run: npm install" >&2
  exit 1
fi
if [ ! -f "$HERE/.env" ]; then
  echo ".env not found; copy .env.example to .env and fill in keys" >&2
  exit 1
fi

# Node's fetch ignores HTTPS_PROXY unless told; harmless when no proxy is set.
export NODE_USE_ENV_PROXY=1

# Keys are read from .env inside Node (dotenv), never exported into the shell.
exec node "$HERE/src/index.js" "$1" "$2"
