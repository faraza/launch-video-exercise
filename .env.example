# Copy to .env (git-ignored). Never commit real keys.
#   cp .env.example .env

# Required: site understanding + script + caption
ANTHROPIC_API_KEY=

# Required for AI clips (Seedance via Ark). Without it the pipeline falls
# back to screenshot pan/zoom motion and still produces a valid video.
ARK_API_KEY=
# BytePlus (global):   https://ark.ap-southeast.bytepluses.com/api/v3
# Volcengine (China):  https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-0-pro-250528

# Optional, unused by default
OPENAI_API_KEY=
GOOGLE_API_KEY=
RUNWAY_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLIP_TIMEOUT_MS=360000
