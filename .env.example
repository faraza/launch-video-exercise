# Copy to .env (git-ignored). Never commit real keys.
#   cp .env.example .env

# Required: site understanding + script + caption
ANTHROPIC_API_KEY=

# Optional: AI clip for the hero shot (Seedance via Ark). Without it the pipeline
# falls back to screenshot pan/zoom motion and still produces a valid video.
ARK_API_KEY=
# BytePlus (global):   https://ark.ap-southeast.bytepluses.com/api/v3
# Volcengine (China):  https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Must be activated in the ModelArk console. Known BytePlus IDs:
#   dreamina-seedance-2-0-mini-260615 (default: tested, 720p, ~120s/clip)
#   dreamina-seedance-2-0-fast-260128 (tested, 720p, ~150s/clip; 480p ~100s but soft)
#   dreamina-seedance-2-0-260128,
#   dreamina-seedance-2-5-260628, seedance-1-0-pro-250528, seedance-1-0-pro-fast-251015
SEEDANCE_MODEL=dreamina-seedance-2-0-mini-260615
# SEEDANCE_RESOLUTION=720p     # default: try 1080p, then 720p, then 480p
# SEEDANCE_ALL_SHOTS=1         # animate every screen shot, not just the hero

# Optional, unused by default
OPENAI_API_KEY=
GOOGLE_API_KEY=
RUNWAY_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLIP_TIMEOUT_MS=360000
